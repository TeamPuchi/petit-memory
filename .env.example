# Memory MCP Server Configuration

# Path to the SQLite database file (default: ~/.claude/memories/memory.db)
# MEMORY_DB_PATH=~/.claude/memories/memory.db

# Collection name for memories, stored as metadata (default: claude_memories)
# MEMORY_COLLECTION_NAME=claude_memories

# Sentence-transformers embedding model (default: intfloat/multilingual-e5-base)
# MEMORY_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Enable BM25 hybrid re-ranking (default: true)
# MEMORY_ENABLE_BM25=true

# Storage backend: sqlite | dynamo | dual (default: sqlite)
# "dual" writes to SQLite and DynamoDB, and reads from SQLite only.
# PETIT_MEMORY_STORE=sqlite

# DynamoDB single-table settings (only used when PETIT_MEMORY_STORE=dynamo or dual)
# PETIT_MEMORY_DYNAMO_TABLE=house
# PETIT_MEMORY_HOUSE_ID=
# PETIT_MEMORY_PETIT_ID=
